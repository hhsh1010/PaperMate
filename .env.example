# PaperMate / LightCore 环境变量示例（复制为 .env，密钥不入库，见 docs/10）
# 默认 Local/Spike 用 FakeLLM，无需任何 key 即可跑通内核与 SSE。
# 接真实模型时填对应 provider 的 key（下方按需启用）。

# ---- 主用：DeepSeek（docs/10 成本模型，单次 ≤¥0.3）----
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 可选：OpenAI / Qwen(通义) ----
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 运行配置 ----
# 默认对话模型：fake(本地演示,无需key) | deepseek | openai | qwen
# 接入真实模型两步：① 上方填对应 provider 的 API key；② 此处改为该 provider 名
#   （也可不改这里，直接在前端「设置」页为该会话选模型；前提是 .env 已填 key 且后端已重启）
PAPERMATE_DEFAULT_MODEL=fake

# ---- 监听地址与端口（⚠️ 安全相关，务必读完再改）----
# 这两项**已生效**（2026-09-06 修复：此前它们曾是"死配置"——端口硬编码在
# api/__main__.py，用户改了不生效，容易在"以为已限制访问"的情况下把服务暴露出去）。
#
# 默认 127.0.0.1 = 仅本机可访问，这是**安全默认**。
# 本项目**没有鉴权机制**（定位为本地单用户工具）。一旦改成 0.0.0.0 或局域网地址：
#   · 同网段任何人都能读写全部会话、文档与长期记忆；
#   · `PUT /api/v1/settings` 可覆盖模型密钥等配置。
# 启动时会打印醒目安全告警（可用 PAPERMATE_ACCEPT_PUBLIC_EXPOSURE=1 确认知情后关闭）；
# `GET /api/v1/healthz` 的 `network_exposed` 字段也会反映该状态。
PAPERMATE_HOST=127.0.0.1
PAPERMATE_PORT=8000

# 确需局域网访问时（请自行评估网络环境，或改用容器部署）：
# PAPERMATE_HOST=0.0.0.0
# PAPERMATE_ACCEPT_PUBLIC_EXPOSURE=1
