{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperMate",
  "version": "0.1.3",
  "identifier": "com.papermate.desktop",
  "build": {
    "beforeDevCommand": "echo noop",
    "devUrl": "http://127.0.0.1:8000",
    "beforeBuildCommand": "echo noop",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PaperMate",
        "url": "loading.html",
        "width": 960,
        "height": 640,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/python": "resources/python",
      "resources/backend": "resources/backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "displayLanguageSelector": true
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/codesign.ps1",
          "-FileToSign",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://releases.papermate.app/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_ED25519_PUBLIC_KEY_FROM_gen_update_keys"
    }
  }
}
