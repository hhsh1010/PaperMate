# ===================== LightCore / PaperMate =====================

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# L0 首装仿真/门禁排查用的临时 basetemp（2026-10-06）：pytest 显式指定它可跳过
# 自身对 %TEMP%\pytest-of-* 的垃圾回收，从而绕开沙箱批量删除保护。
# ⚠️ 用 `.l0_bt*/` 通配而不是逐个列出：排查时随手起的目录名会变（.l0_bt / .l0_bt2 / …），
#    漏一条就会把上千个临时文件提交进仓库。
.l0_bt*/
.l0_tmp/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/

# ---- 环境与密钥（★ 绝不可入库）----
.env
.env.*
!.env.example
# 演示模式环境文件**必须入库**：只有 `VITE_DEMO_MODE=1`，不含任何密钥（GitHub Pages 静态 demo 靠它开启）
!web/.env.demo
*.key
*.pem

# ---- 运行时数据 ----
# 含：API key（provider_settings.json）、用户上传的论文、SQLite、faiss 索引、快照、日志
data/
*.db
*.sqlite3
*.tmp

# ---- 前端 / Node ----
# ⚠️ 2026-10-06 修复：原先只写 `web/node_modules/`（路径特定），
#    导致新增的 `desktop/node_modules/`（`npm install` 装的 Tauri CLI）**未被忽略**
#    ⇒ 只要一次 `git add -A` 就会把上万个文件提交进仓库。
#    ⇒ 改为**通用裸模式** `node_modules/`（匹配任意层级）。
#    ★ 判别两种写法的取舍：这里的名字（node_modules）**不可能与源码包同名**，
#      所以用裸模式是安全的；而 `models/` 那种会撞源码包名的，必须锚定成 `/models/`。
node_modules/
web/dist/
web/dist.old/
# 演示模式产物（npm run build:demo）—— 由 .github/workflows/pages.yml 发布到 GitHub Pages
web/dist-demo/

# ---- 宿主工具缓存（非本项目产物）----
.dsh-plugin-cache/

# ---- 项目工作记忆与内部记录（隐私）----
.workbuddy/

# ---- 重模型权重（BGE-M3 等，体积大）----
# ⚠️ 必须锚定成 `/models/`，不能写裸 `models/`（2026-10-06 修复）：
#    裸模式（无前导斜杠）匹配**任意层级**的 models 目录 ⇒ 实测把源码包
#    `src/papermate/models/`（db.py + migrations.py，约 27KB）**静默排除出整个 git 历史**
#    ⇒ 克隆/导出的代码启动即 `ModuleNotFoundError: No module named 'papermate.models'`。
#    判据：写 .gitignore 排除"某类产物"时，若该名字**恰好也是源码包名**（models/weights/assets/
#    lib/util/config），一律加前导 `/` 锚定到仓库根。
/models/
.cache/huggingface/

# ---- 运行产物 ----
eval/*.log
eval/_*.jsonl
eval/_*.lock
eval/*.bak-*
eval/_*.txt

# ---- 备份 / 临时 / 编辑器 ----
*.bak-*
*~
*.orig
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 追加（2026-10-05，Git 化体检发现）----
# Vite 自动生成的临时配置文件（实测 4 个已混进拟入库清单）
web/vite.config.ts.timestamp-*
# 单实例锁残留（run_tests.py 与探针脚本）
.pytest_instance.lock
.rerank_arms.lock
eval/*.lock

# ---- D2（2026-10-05）：eval 只入库「脚本 + 输入 + judge 提示词」----
# ★ 保留：eval/*.py · eval/cases/**（gold 集）· eval/corpus/**（评测语料）
#         eval/judge_prompts/**（判官提示词 —— 缺它评测无法复现，故随代码入库）
# 排除：报告 / 判分标注 / 探针结果 —— 属内部质量活动产物
eval/report_*.json
eval/eval_report.json
eval/rerank_arms_quality_*.json
eval/judge_*.json
eval/judge_*.jsonl
eval/judge_*.csv
eval/judge_*.md
eval/_*.json
eval/*.csv
eval/*.txt

# ---- 文档（2026-10-08 决策：docs/ 整目录不上传）----
# ★ 原因：① docs/ 混合了产品文档与内部工作记录（原用"默认拒绝+白名单"，但白名单曾把
#     求职材料《技术书/11-简历呈现与面试指南》带入）；② 内部文档（实施记录/诊断/台账）体量大，
#     与产品代码无运行时依赖（已核：代码内对 docs/ 只有注释引用，无 open/read）。
#   ⇒ 现改为**整目录不上传**：文档一律留在本地。
#   ⚠️ README 等公开文档中指向 docs/ 的链接在公开仓库将失效（已知、有意接受）。
#   ⚠️ 打包不受影响：build-resources.ps1 只拷 src/ 与 web/；.dockerignore 亦已排除 docs/。
docs/
# ---- docx 原子写残留的空临时目录（实测 29 个）----
docs/tmp*/

# ---- Tauri 桌面客户端（构建产物 / 捆绑资源，体积大，不入库）----
desktop/src-tauri/target/
desktop/src-tauri/resources/
desktop/src-tauri/gen/
desktop/keys/

